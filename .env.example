# ── EVIDENCE / STORAGE (S3 + GuardDuty) ───────────────────────────────────────
# This ONE private bucket backs BOTH Safety Community evidence AND AI OCR receipt files. It must NOT be the
# public media bucket (avatars/showcase photos): `media/(.*)` is excluded from the session middleware and is
# world-readable by design. Receipts are vendor invoices — totals, account numbers, supplier terms.
#
# Leave EVIDENCE_S3_BUCKET unset and everything degrades HONESTLY: bytes are not persisted, previews return a
# `notconnected:` marker instead of a fabricated URL, and nothing is ever reported malware-clean.
AWS_REGION=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_REGION=                 # optional; falls back to AWS_REGION
EVIDENCE_S3_ENDPOINT=               # optional; for S3-compatible providers (R2, Spaces, MinIO)
EVIDENCE_S3_PREFIX=                 # optional key prefix
EVIDENCE_S3_FORCE_PATH_STYLE=0      # 1 for MinIO / most S3-compatible endpoints

# Malware scanning is OUT OF BAND: a scanner (AWS GuardDuty Malware Protection for S3, a ClamAV lambda, …)
# tags the object, and the app READS the tag. Set to 1 once the bucket actually has a scanner attached.
# Fails closed — no tag, a failed scan, or an S3 error all read as `unscanned`, NEVER `clean`.
EVIDENCE_SCAN_ENABLED=0
EVIDENCE_SCAN_TAG_KEY=              # optional; defaults to GuardDuty's `GuardDutyMalwareScanStatus`

# ── OCR EXTRACTION (AWS Textract AnalyzeExpense) ──────────────────────────────
# Reads receipts/invoices straight out of EVIDENCE_S3_BUCKET — no second bucket, no copy, no bytes through the
# API. Purpose-built for expenses: it returns typed VENDOR_NAME / TOTAL / TAX / line items rather than a bag of
# words we would have to guess at.
# With no bucket (or ENABLED=0) NO provider is bound: extraction honestly reports `unavailable` and the document
# routes to Manual Entry, where a person keys the values in. It never invents a vendor or a total.
# Textract is billed PER PAGE — hence the explicit kill-switch.
OCR_TEXTRACT_ENABLED=1              # 0 to disable extraction while keeping storage + scanning
OCR_TEXTRACT_REGION=                # optional; falls back to EVIDENCE_S3_REGION, then AWS_REGION

# Per-PAGE cost estimate in micro-USD, written to ai_usage_logs.cost_estimate_cents. Default 10000 = USD 0.01,
# AWS's published AnalyzeExpense list price. It is an ESTIMATE, not a figure read back from a bill — override it
# on negotiated pricing rather than silently accruing a number that is wrong. 0 = record usage, no cost estimate.
# NOTE the two different units: the TENANT is billed in `scans` (ai-catalog.ts: 500 included, 8c overage, one
# scan per extraction regardless of page count); this is the PLATFORM's cost, which really is per page.
OCR_COST_MICRO_USD_PER_PAGE=10000

# ── AI ENTITLEMENT ENFORCEMENT ────────────────────────────────────────────────
# Does a tenant who CANCELS an AI package keep using it? Until now, for eight of them, yes — and their included
# usage limits were unenforceable because nothing metered them. AiEntitlementGuard closes that, but turning it on
# REVOKES A FEATURE FROM LIVE TENANTS, so it does not default to doing so.
#
#   off      the guard does nothing
#   observe  (DEFAULT) the call still runs, but a tenant who is unsubscribed / expired / over-limit is recorded
#            in ai_usage_logs as action='would_block', status=blocked_*. Run this for a billing period and read
#            the impact off the AI Usage screen: you will know exactly who breaks, and how often, BEFORE anyone
#            loses access.
#   enforce  actually deny: 403 unpaid/cancelled/expired, 429 over-limit.
#
# Public routes, webhooks, the API-key booking gateway, live telephony, and SUPER_ADMIN are never gated.
AI_ENTITLEMENT_ENFORCEMENT=observe

# ── FRONTEND (Vite — build time) ──────────────────────────────────────────────
# MUST be an absolute https URL for NATIVE builds (a relative base resolves against capacitor://localhost and
# every API call fails). Leave blank for same-origin web dev.
VITE_API_BASE=
VITE_GOOGLE_MAPS_BROWSER_API_KEY=replace-me-with-a-real-secret
VITE_GOOGLE_MAPS_MAP_ID=
VITE_NOTIFIER_URL=https://example.com
VITE_OWNER_WEB_URL=https://example.com
VITE_TECH_WEB_URL=https://example.com
# Browser push for the desktop apps (pos-web, owner-web) — developer merge Oct 6 2026, ONE client (@aipowersalon/web-push).
# VITE_FIREBASE_WEB_CONFIG = the Firebase console's web-app config object as JSON (apiKey, projectId, messagingSenderId,
# appId[, authDomain]) — these are PUBLIC identifiers, not secrets; VITE_FIREBASE_VAPID_KEY = Cloud Messaging → Web Push
# certificates key pair. Both unset → no prompt, no registration, nothing loads. The SAME Firebase project's service
# account goes in FCM_SERVICE_ACCOUNT_JSON (server side) — that is what delivers to these tokens.
VITE_FIREBASE_WEB_CONFIG=
VITE_FIREBASE_VAPID_KEY=
# 23-inch dual-screen spec §122–§125: where the customer display app is served. The POS offers "Open on second screen"
# (placed on the second monitor where the browser allows it) only when this is set. Blank: the button is not shown.
VITE_CUSTOMER_DISPLAY_URL=

