    "check:dialogs": "node scripts/audit-native-dialogs.mjs",
    "check:money": "node scripts/audit-money-parsing.mjs",
    "check:one-payroll-calculation": "node scripts/check-one-payroll-calculation.mjs",
    "check:one-tax-calculation": "node scripts/check-one-tax-calculation.mjs",
    "check:silent-catch": "node scripts/check-silent-catch.mjs",
    "check:as-any": "node scripts/check-as-any.mjs",
