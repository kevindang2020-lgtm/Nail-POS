{
  "name": "@aipowersalon/api",
  "version": "1.0.0",
  "private": true,
  "description": "AIPowerSalon multi-tenant nail-salon POS — NestJS API (merged from delivery bundles).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
