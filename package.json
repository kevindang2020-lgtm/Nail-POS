{
  "name": "aipowersalon-pos",
  "version": "1.0.0",
  "private": true,
  "description": "AIPowerSalon \u2014 multi-tenant nail-salon POS SaaS (merged monorepo).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @aipowersalon/api",
    "build:api": "npm run build --workspace @aipowersalon/api",
    "build:frontends": "sh scripts/build-frontends.sh",
    "start:api": "node apps/api/dist/main.js",
    "dev:pos": "npm run dev --workspace aipowersalon-pos-web",
    "dev:admin": "npm run dev --workspace aipowersalon-admin-web",
    "dev:tech": "npm run dev --workspace aipowersalon-tech-web",
    "dev:customer": "npm run dev --workspace aipowersalon-customer-web",
    "db:migrate": "node apps/api/scripts/migrate.mjs",
    "db:seed": "tsx apps/api/scripts/seed.ts",
    "db:seed:demo": "tsx apps/api/scripts/seed-demo.ts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:seed:demo",
    "typecheck": "npm run typecheck --workspace @aipowersalon/api",
    "test": "bash scripts/run-core-specs.sh",
    "lint": "node tooling/ci/lint-ratchet.mjs",
    "lint:fix": "eslint apps/*/src --fix",
    "dev:api": "node --env-file=.env apps/api/dist/main.js",
    "dev:owner": "npm run dev --workspace aipowersalon-owner-web",
    "dev:display": "npm run dev --workspace aipowersalon-customer-display",
    "dev:frontend": "concurrently -n pos,admin,tech,customer,owner,display,managerpay -c blue,magenta,green,cyan,yellow,gray,red \"npm:dev:pos\" \"npm:dev:admin\" \"npm:dev:tech\" \"npm:dev:customer\" \"npm:dev:owner\" \"npm:dev:display\" \"npm:dev:managerpay\"",
    "dev:backend": "npm run dev:api",
    "dev:all": "concurrently -k -n api,pos,admin,tech,customer,owner,display,managerpay -c white,blue,magenta,green,cyan,yellow,gray,red \"npm:dev:api\" \"npm:dev:pos\" \"npm:dev:admin\" \"npm:dev:tech\" \"npm:dev:customer\" \"npm:dev:owner\" \"npm:dev:display\" \"npm:dev:managerpay\"",
    "dev": "npm run dev:all",
    "setup:local": "bash scripts/setup-local.sh",
    "seed:local": "tsx apps/api/scripts/seed-local-accounts.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "e2e:workflow": "node apps/api/scripts/e2e-workflow-run.mjs",
    "verify:display": "cd apps/api && node scripts/live-display-lifecycle.mjs",
    "verify:import": "node apps/api/scripts/verify-customer-import.mjs",
    "dev:managerpay": "npm run dev --workspace aipowersalon-manager-pay-web",
    "db:provision": "bash scripts/db-provision.sh",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose down",
    "db:status": "bash scripts/db-status.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "local:setup": "bash scripts/setup-local.sh",
    "security:fast": "npm run security:fast --workspace @aipowersalon/api",
    "security:full": "npm run security:full --workspace @aipowersalon/api",
    "architecture:test": "node tooling/architecture-tests/run.mjs",
    "architecture:baseline": "node tooling/architecture-tests/run.mjs --baseline",
    "build:packages": "npm run build --workspace @aipowersalon/tenant-context --workspace @aipowersalon/api-contracts --workspace @aipowersalon/date-time --workspace @aipowersalon/realtime-contracts --workspace @aipowersalon/observability --workspace @aipowersalon/database --workspace @aipowersalon/permissions --workspace @aipowersalon/security --workspace @aipowersalon/auth --workspace @aipowersalon/money --workspace @aipowersalon/events --workspace @aipowersalon/notifications --workspace @aipowersalon/config --workspace @aipowersalon/cache --workspace @aipowersalon/media",
    "build:modules": "node tooling/modules/build-modules.mjs",
    "ci:gates": "node tooling/ci/run-gates.mjs",
    "hooks:install": "node tooling/security/install-hooks.mjs",
    "ci:test:api": "node tooling/ci/run-tests.mjs api",
    "ci:test:modules": "node tooling/ci/run-tests.mjs modules",
    "ci:test:apps": "node tooling/ci/run-tests.mjs apps",
    "ci:test:packages": "node tooling/ci/run-tests.mjs packages",
    "ci:test:race": "node tooling/ci/run-race-tests.mjs",
    "security:deps": "node tooling/security/check-npm-audit.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "axe-core": "^4.10.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "react-icons": "^5.7.0"
  },
  "overrides": {
    "multer": "^2.5.0",
    "qs": "^6.16.1",
    "body-parser": "^1.20.6",
    "@grpc/grpc-js": "^1.14.6"
  }
}
