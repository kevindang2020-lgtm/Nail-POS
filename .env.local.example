# Local dev/testing config (Docker Postgres). The setup script copies this to .env if .env is missing.
# Values match docker-compose.yml and the POS/Admin Vite proxies (which target :3000).

DATABASE_URL=postgres://aps:aps@localhost:5432/aps
REPO_DRIVER=postgres
PORT=3000
NODE_ENV=development

# Cookie signing + MFA/secret encryption (any non-empty values for local dev; keep MFA_ENC_KEY >= 32 chars)
AUTH_SESSION_SECRET=dev-secret-change-me
MFA_ENC_KEY=dev-mfa-key-0123456789abcdef0123456789

# Simulated card processing so you can test Checkout (card / split / refund / void) WITHOUT a real Fiserv MID.
# Records 'sbx_' approvals/refunds/voids only — never real charges. Unset this to see the honest
# "payment gateway not configured" path instead.
PAYMENTS_SANDBOX=1

# Pilot tenant the seeds create — leave as-is so the demo data lines up.
SEED_TENANT_CODE=PILOT01
