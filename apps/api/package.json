    "check:no-print": "node scripts/check-no-print.mjs",
    "check:i18n-ns-collisions": "node --no-warnings --experimental-strip-types ../../tooling/i18n/check-ns-collisions.mjs",
    "check:boot": "npm run -s build --workspace @aipowersalon/api >/dev/null 2>&1 || tsc -p tsconfig.build.json; node scripts/di-check.mjs",
    "check:silent-sql": "node scripts/audit-silent-sql.mjs",
    "check:sql-identifiers": "node scripts/audit-sql-identifiers.mjs",
    "check:realtime-pushes": "node scripts/audit-realtime-pushes.mjs",
