{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@aipowersalon/ai": [
        "../../modules/ai/dist/index.d.ts"
      ],
      "@aipowersalon/date-time": [
        "../../packages/date-time/dist/index.d.ts"
      ],
      "@aipowersalon/api-contracts": [
        "../../packages/api-contracts/dist/index.d.ts"
      ],
      "@aipowersalon/api-contracts/tenant": [
        "../../packages/api-contracts/dist/tenant/index.d.ts"
      ],
      "@aipowersalon/auth": [
        "../../packages/auth/dist/index.d.ts"
      ],
      "@aipowersalon/customers": [
        "../../modules/customers/dist/index.d.ts"
      ],
      "@aipowersalon/database": [
        "../../packages/database/dist/index.d.ts"
      ],
      "@aipowersalon/tenant-context": [
        "../../packages/tenant-context/dist/index.d.ts"
      ],
      "@aipowersalon/deals": [
        "../../modules/deals/dist/index.d.ts"
      ],
      "@aipowersalon/events": [
        "../../packages/events/dist/index.d.ts"
      ],
      "@aipowersalon/events/nest": [
        "../../packages/events/dist/nest/index.d.ts"
      ],
      "@aipowersalon/database/nest": [
        "../../packages/database/dist/nest/index.d.ts"
      ],
      "@aipowersalon/gift-cards": [
        "../../modules/gift-cards/dist/index.d.ts"
      ],
      "@aipowersalon/memberships": [
        "../../modules/memberships/dist/index.d.ts"
      ],
      "@aipowersalon/money": [
        "../../packages/money/dist/index.d.ts"
      ],
      "@aipowersalon/notifications": [
        "../../packages/notifications/dist/index.d.ts"
      ],
      "@aipowersalon/observability": [
        "../../packages/observability/dist/index.d.ts"
      ],
      "@aipowersalon/payments": [
        "../../modules/payments/dist/index.d.ts"
      ],
      "@aipowersalon/permissions": [
        "../../packages/permissions/dist/index.d.ts"
      ],
      "@aipowersalon/permissions/guards": [
        "../../packages/permissions/dist/guards/index.d.ts"
      ],
      "@aipowersalon/queue": [
        "../../modules/queue/dist/index.d.ts"
      ],
      "@aipowersalon/realtime-contracts": [
        "../../packages/realtime-contracts/dist/index.d.ts"
      ],
      "@aipowersalon/reports": [
        "../../modules/reports/dist/index.d.ts"
      ],
      "@aipowersalon/security": [
        "../../packages/security/dist/index.d.ts"
      ],
      "@aipowersalon/security-center": [
        "../../modules/security-center/dist/index.d.ts"
      ],
      "@aipowersalon/workforce": [
        "../../modules/workforce/dist/index.d.ts"
      ],
      "@aipowersalon/api-contracts/*": [
        "../../packages/api-contracts/dist/*/index.d.ts"
      ],
      "@aipowersalon/audit": [
        "../../modules/audit/dist/index.d.ts"
      ],
      "@aipowersalon/cache": [
        "../../packages/cache/dist/index.d.ts"
      ],
      "@aipowersalon/catalog": [
        "../../modules/catalog/dist/index.d.ts"
      ],
      "@aipowersalon/checkout": [
        "../../modules/checkout/dist/index.d.ts"
      ],
      "@aipowersalon/config": [
        "../../packages/config/dist/index.d.ts"
      ],
      "@aipowersalon/security/nest": [
        "../../packages/security/dist/nest/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/test-support/**"
  ]
}
