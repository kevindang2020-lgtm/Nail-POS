    "test:harness": "bash scripts/run-harnesses.sh",
    "e2e:admin": "node scripts/e2e-admin-browser.mjs",
    "verify:all": "npm test && npm run test:harness",
    "seed": "tsx scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry-run",
    "e2e:live": "node scripts/e2e-live.mjs",
    "check:sql": "node scripts/sql-prepare-check.mjs",
    "check:di": "node scripts/di-dead-inject-check.mjs",
    "check:impossible": "node scripts/impossible-predicate-check.mjs",
    "check:nav": "node scripts/audit-sidebars.mjs",
    "check:crosswire": "node scripts/audit-crosswire.js",
    "check:nav:deep": "node scripts/audit-sidebar-deep.mjs",
