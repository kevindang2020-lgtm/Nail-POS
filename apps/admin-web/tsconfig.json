{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": { "@aipowersalon/realtime-client": ["../../packages/realtime-client/src/index.ts"], "@aipowersalon/realtime-contracts": ["../../packages/realtime-contracts/src/index.ts"], "@aipowersalon/money": ["../../packages/money/src/index.ts"], "@aipowersalon/api-contracts/tenant": ["../../packages/api-contracts/src/tenant/index.ts"], "@aipowersalon/api-contracts/platform": ["../../packages/api-contracts/src/platform/index.ts"], "@aipowersalon/api-client": ["../../packages/api-client/src/index.ts"], "@aipowersalon/realtime-client/*": ["../../packages/realtime-client/src/*"],  "@aipowersalon/ui": ["../../packages/ui/src/index.ts"] }
  },
  "include": ["src", "vite.config.ts"]
}
