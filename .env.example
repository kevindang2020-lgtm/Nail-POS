# --- Global Tech / invitation-SMS arc additions (merged) ---
TWILIO_FROM=+15550000000
SENDGRID_API_KEY=
# Optional — the sender defaults to nailsalons@aipowersalon.com (verify it as a sender in SendGrid)
# SENDGRID_FROM=nailsalons@aipowersalon.com
APP_BASE_URL=https://pos.example.com

# --- Push notifications (APNs + FCM HTTP v1) -------------------------------------------------------------------
# iOS device tokens (Capacitor) are raw APNs tokens → delivered via APNs token-based auth (HTTP/2).
# Provide the .p8 key as PEM (APNS_KEY_P8, \n-escaped ok) or base64 (APNS_KEY_P8_B64).
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
# Default apns-topic (an app bundle id) + optional per-app overrides matching the `app` sent at /push/register.
APNS_TOPIC=
APNS_TOPIC_TECH=
APNS_TOPIC_CUSTOMER=
APNS_TOPIC_OWNER=
APNS_TOPIC_MANAGER=
# production (default) | sandbox
APNS_ENV=production
# Android/web tokens → FCM HTTP v1 with an OAuth2 service account: raw JSON or base64 of it.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_B64=
# RETIRED: the legacy FCM server-key API was shut down by Google in June 2024. FCM_SERVER_KEY is recognized only to
# warn at startup — it never selects a provider. Use FCM_SERVICE_ACCOUNT_JSON above.

# --- Application intake (Free POS Package form) ---
# Field-level encryption for applicant EIN at rest (32 bytes, hex or base64). Unset => only EIN last-4 is stored.
APP_DATA_ENCRYPTION_KEY=
# Applicant confirmations reuse the platform-wide provider convention:
# SENDGRID_API_KEY + SENDGRID_FROM  -> confirmation email
# TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM -> consent-gated confirmation SMS
# Unset providers are logged honestly as 'skipped' in notification_delivery_logs (never fake sends).

# ── Customer identity sync (7:00 PM daily reconciliation) ──────────────────────────────────────────────
# OFF unless truthy (1/true/yes/on). When armed, the API logs "Customer sync worker armed" on boot —
# no log line means no 7 PM run. Verification runbook: docs/handoff/VERIFY_7PM_CUSTOMER_SYNC.md
CUSTOMER_SYNC_WORKER_ENABLED=0
# Timezone the 19:00 window is evaluated in (also used by the missed-run watchdog). Default America/New_York.
PLATFORM_TIMEZONE=America/New_York

# Constitution 8 — the outbox publisher. ON in production by default (every replica may run it; the outbox claims with
# SKIP LOCKED); OFF in development/tests unless set. Set to off to stop delivery deliberately. Runs only in a process whose
# PROCESS_ROLE includes background jobs (all, or worker) — a PROCESS_ROLE=api web replica needs a worker service beside it.
# EVENT_PUBLISHER_ENABLED=on

# Constitution 3 Step 2 — the ACCESS token life in seconds (default 900 = 15 min; 60..43200). The session cookie lives the
# session's life and POST /auth/refresh rotates the refresh token to mint a new access token.
# AUTH_ACCESS_TTL=900


# Constitution 3 Step 6 — service tokens for internal routes (jobs, schedulers, billing ingress, backups). 32+ characters,
# DIFFERENT from AUTH_SESSION_SECRET. Schedulers call: node apps/api/scripts/call-internal.mjs <job>. While the old
# per-route variables (JOBS_SECRET, *_CRON_SECRET, MEMBERSHIP_BILLING_SECRET, AI_BILLING_WEBHOOK_SECRET, BACKUP_REPORT_TOKEN)
# are set, their legacy headers still work; remove each to retire it.
# SERVICE_TOKEN_SECRET=

# Constitution 5 §11–13 — every route is also /api/v1/*; every app build calls /api/v1 (BUILD_PLAN Phase 12). Legacy
# paths send Deprecation + Link + Sunset (default 2027-01-06, 90 days after the move; a date here moves it, `off` drops
# it) and count in aipowersalon_api_legacy_path_requests_total. The legacy paths keep working after the date.
# API_LEGACY_SUNSET=

# Security Deep Scan §93 (Nov 5 2026) — process-wide egress allowlist (packages/security/src/egress-policy.ts).
# report (default): unlisted outbound hosts are logged once + counted; enforce: refused before connecting; off: not installed.
# Approved automatically: provider domains (Twilio, CardPointe/CardConnect/Clover/Fiserv, SendGrid, Apple push, Google,
# AWS S3, Cloudflare R2, Retell, OpenAI, Anthropic), every host in a *_URL / *_ENDPOINT / *_BASE_URL / *_HOST variable,
# loopback and *.railway.internal. Tenant-typed URLs go through safeOutboundRequest's own SSRF guard.
# EGRESS_POLICY=report
# EGRESS_ALLOWLIST=partner.example.com,.trusted-suffix.example
# G9 Backup & DR: the ISOLATED recovered clone a restore job compares against (never the live database).
# RESTORE_STAGING_DATABASE_URL=
