{
  "$comment": "Constitution 1 §55-57: the ONE retention + deletion policy. Read by the central retention executor (modules/super-admin/src/super-admin-security/retention-executor.*), by the ownership registry (apps/api/scripts/db-ownership.mjs: retention_class + delete_policy per table; absent table = indefinite / none) and documented in docs/DATA_RETENTION_AND_DELETION_POLICY.md. delete_policy: never | soft_delete | hard_delete_after_days | anonymize_after_days. executor: 'central' = the retention.execute job runs it; a path = an older dedicated sweep owns it (kept, listed here so the policy is complete); 'none' = nothing deletes it automatically. Financial and audit history is never deleted.",
  "version": 1,
  "classes": {
    "temporary": { "description": "one-time codes, challenges, short-lived tokens and holds — worthless once expired", "default_policy": "hard_delete_after_days" },
    "operational": { "description": "queues, jobs, sessions, telemetry rollups — kept while useful for operations", "default_policy": "hard_delete_after_days" },
    "customer_history": { "description": "the salon's customer records and what they configured — soft-deleted, never silently purged", "default_policy": "soft_delete" },
    "financial": { "description": "money movement and its evidence — corrected by reversal records, never deleted", "default_policy": "never" },
    "security": { "description": "sign-in attempts and session history — kept for the investigation window, then deleted", "default_policy": "hard_delete_after_days" },
    "audit": { "description": "who did what — append-only, never deleted (audit legal holds overlay it)", "default_policy": "never" },
    "ai": { "description": "AI usage, prompts and outputs — usage feeds billing (never); content follows the tenant's AI settings", "default_policy": "never" },
    "communication": { "description": "SMS / email delivery logs — consent and delivery evidence", "default_policy": "hard_delete_after_days" },
    "media": { "description": "stored OBJECTS (images, attachments) behind media rows — Phase 11 §169: the media.lifecycle job (apps/api/src/media/media-lifecycle.ts) deletes the object of a row soft-deleted more than object_days ago (re-checking rows deleted in the last lookback_days, so a missed day is caught) and abandoned partial uploads older than temp_upload_hours; the ROW keeps its own table policy. Bucket-side rules: deploy/storage-lifecycle.json", "default_policy": "hard_delete_after_days", "object_days": 7, "lookback_days": 3, "temp_upload_hours": 24, "tables": { "support_ticket_attachments": { "key_column": "storage_key", "deleted_column": "deleted_at", "store": "support_attachments" }, "display_ad_media": { "key_column": "storage_key", "variants_column": "variants", "deleted_column": "deleted_at" } } }
  },
