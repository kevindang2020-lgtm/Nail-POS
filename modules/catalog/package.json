{
  "name": "@aipowersalon/catalog",
  "version": "0.1.0",
  "private": true,
  "description": "The catalog domain module (Constitution 13 Phase 6). Depends on packages only; consumed compiled by apps/api.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipowersalon/api-contracts": "*",
    "@aipowersalon/cache": "*",
    "@aipowersalon/database": "*",
    "@aipowersalon/permissions": "*",
    "@nestjs/common": "^10.4.22",
    "kysely": "^0.27.4"
  },
  "devDependencies": {
    "@types/node": "20.11.30"
  }
}
