    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipowersalon/api-contracts": "*",
    "@aipowersalon/config": "*",
    "@aipowersalon/database": "*",
    "@aipowersalon/date-time": "*",
    "@aipowersalon/events": "*",
    "@aipowersalon/observability": "*",
    "@aipowersalon/permissions": "*",
    "@nestjs/common": "^10.4.22",
    "exceljs": "^4.4.0",
    "kysely": "^0.27.4"
  },
  "devDependencies": {}
}
