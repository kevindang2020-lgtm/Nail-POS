{
  "name": "@aipowersalon/permissions",
  "version": "0.1.0",
  "private": true,
  "description": "The authorization kernel (roles, capabilities, tenant/branch scope, client-key stripping) and the Nest guards every controller uses (Constitution 13 §76–77). Consumed compiled by the API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./guards": {
      "types": "./dist/guards/index.d.ts",
      "default": "./dist/guards/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipowersalon/tenant-context": "*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "reflect-metadata": "0.2.2"
  }
}
