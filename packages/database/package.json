{
  "name": "@aipowersalon/database",
  "version": "0.1.0",
  "private": true,
  "description": "The typed Kysely schema (DB), the DATABASE/DATABASE_READ handles and the global Nest DatabaseModule (Constitution 13 §72). Consumed compiled by the API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "default": "./dist/nest/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipowersalon/api-contracts": "*",
    "@aipowersalon/date-time": "*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "kysely": "^0.27.4",
    "pg": "^8.11.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.5"
  }
}
