{
  "compilerOptions": {
    "target": "ES2021", "module": "commonjs", "moduleResolution": "node", "strict": true, "esModuleInterop": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "declaration": true, "rootDir": "src", "outDir": "dist", "skipLibCheck": true, "types": ["node"],
    "paths": {
      "@aipowersalon/database": ["../database/dist/index.d.ts"],
      "@aipowersalon/observability": ["../observability/dist/index.d.ts"],
      "@aipowersalon/realtime-contracts": ["../realtime-contracts/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
