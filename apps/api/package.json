    "check:ai-platform": "node scripts/audit-ai-platform.mjs",
    "check:ai-dod": "node scripts/audit-ai-dod.mjs",
    "measure:ai-capacity": "npx tsx scripts/measure-ai-capacity.mjs",
    "eval:ai": "npx tsx scripts/run-ai-evals.mjs",
    "check:ai-infra-duplicates": "node scripts/audit-ai-infra-duplicates.mjs",
    "check:tenant-builder": "node scripts/tenant-builder-check.mjs",
    "start:worker": "node dist/worker.js",
    "uat:cardpointe": "node scripts/uat/cardpointe-uat.mjs",
    "check:lint": "node ../../tooling/ci/lint-ratchet.mjs",
