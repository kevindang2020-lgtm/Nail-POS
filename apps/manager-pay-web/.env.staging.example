# apps/manager-pay-web — staging build variant (BUILD_PLAN Phase 13 D, Constitution 6 §133–136). Copy to .env.staging (never committed)
# and build with `npx vite build --mode staging`, then `APS_MOBILE_ENV=staging npx cap sync`.
# Purpose: staging — the build Face ID is first verified on (FACE_ID_ENABLED=1 on the staging API).
# No secret ever goes here: everything in a VITE_* variable is compiled into the app bundle and readable by anyone.
VITE_API_BASE=https://<staging-api-host>
VITE_APP_ENV=staging
