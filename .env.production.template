# ==============================================================================
# AIPowerSalon API — PRODUCTION environment template
# ==============================================================================
# Every variable the API reads, grouped and flagged. Copy the values you need
# into your host's env/secrets manager (Railway/Render/Fly variables, etc.).
#
#   [REQUIRED]  the app will not boot / a core path breaks without it
#   [SECRET]    generate a strong random value; NEVER commit the real value
#   [SET-FOR-PROD] has a dev default that is wrong in production (e.g. CORS)
#   (everything else is optional — the feature it controls stays off/default)
#
# Generate a 32-byte hex secret:   openssl rand -hex 32
# Generate a 32-char AES key:      openssl rand -hex 16   (16 bytes = 32 hex chars)
# ==============================================================================

# ---- Core boot (the app refuses to start / auth breaks without these) --------
NODE_ENV=production
PORT=3000

REPO_DRIVER=postgres
DATABASE_URL=                        # [REQUIRED] postgres connection string (through the pooled endpoint in prod)
AUTH_SESSION_SECRET=                 # [REQUIRED][SECRET] openssl rand -hex 32  — signs session tokens
MFA_ENC_KEY=                         # [REQUIRED][SECRET] openssl rand -hex 16  — 32-hex-char AES key for TOTP secrets

# ---- Web / CORS / base URLs (wrong defaults in prod — SET THESE) -------------
WEB_CORS_ORIGINS=                    # [SET-FOR-PROD] comma-separated app origins, e.g. https://pos.aipowersalon.com,https://admin.aipowersalon.com
APP_BASE_URL=                        # [SET-FOR-PROD] canonical app URL used in invite/link emails
PUBLIC_APP_URL=                      # [SET-FOR-PROD] public app URL used in email layouts
ADMIN_BASE_URL=                      # optional fallback for invite links if APP_BASE_URL unset
MAX_BODY_SIZE=                       # optional request body cap (default is fine for most)
APP_VERSION=                         # optional build/version string surfaced in health

# ---- Database pooling / read replica (Scaling Phase 1 & 2 — flip when needed)-
PG_POOL_MAX=10                       # keep small (5-10) when behind PgBouncer; the pooler multiplexes
PG_READ_POOL_MAX=10                  # replica pool size (only used if DATABASE_REPLICA_URL is set)
DATABASE_REPLICA_URL=                # Phase 2: set to the read replica; unset = reads fall back to primary (safe)
# PGHOST / PGPORT / PGUSER / PGDATABASE are read only if DATABASE_URL is not a full URL — prefer DATABASE_URL.

# ---- Redis: cache + rate limit + login throttle (Scaling Phase 3) ------------
CACHE_STORE=                         # Phase 3: set to `redis` to enable the read-through cache (default: in-memory/noop)
CACHE_REDIS_URL=                     # redis url for the cache (falls back to REDIS_URL)
CACHE_PREFIX=                        # optional cache key prefix (default aps:cache:)
RATE_LIMIT_STORE=                    # Phase 3: set to `redis` to enable per-tenant rate limiting
RATE_LIMIT_REDIS_URL=                # redis url for rate limiting (falls back to REDIS_URL)
RATE_LIMIT_MAX_PER_TENANT=           # optional: requests per window per tenant (default 600)
RATE_LIMIT_WINDOW_MS=                # optional: window length in ms (default 60000)
LOGIN_THROTTLE_STORE=                # set to `redis` to share login throttle across instances
LOGIN_THROTTLE_REDIS_URL=            # redis url for login throttle (falls back to REDIS_URL)
LOGIN_THROTTLE_PREFIX=               # optional prefix
REALTIME_BUS=                        # set to `redis` to fan out realtime events across instances (default: in-process)
REALTIME_REDIS_URL=                  # redis url for the realtime bus (falls back to REDIS_URL)
REALTIME_CHANNEL=                    # optional realtime channel name
REDIS_URL=                           # single shared redis; the *_REDIS_URL vars each fall back to this

# ---- Payments (Fiserv / CardPointe / Bolt + Clover ONLY — never Stripe/Square)
PAYMENTS_SANDBOX=1                   # [SET-FOR-PROD] set to 0 for live processing when you go live
PAYMENTS_ALLOW_ENV_FALLBACK=         # optional: allow env-based gateway creds (prefer per-tenant stored creds)
PAYMENTS_WEBHOOK_RAW_BODY=           # optional: keep raw body for webhook signature verification
FISERV_MERCHANT_ID=                  # [SECRET] only if using env-fallback Fiserv creds
FISERV_SECRET=                       # [SECRET]
FISERV_RESIDUAL_URL=                 # optional residual-reporting integration
FISERV_RESIDUAL_AUTH=                # [SECRET]
HARDWARE_PAYMENT_CRON_ENABLED=       # optional terminal-capture cron
HARDWARE_PAYMENT_CRON_SECRET=        # [SECRET] required if the cron is enabled

# ---- Encryption KEKs (required ONLY when you use the feature they protect) ----
AI_PROVIDER_KEK=                     # [SECRET] encrypts stored AI provider keys
PROVIDER_VAULT_KEK=                  # [SECRET] encrypts stored integration provider secrets
FUNDING_VAULT_KEK=                   # [SECRET] encrypts stored funding/bank details
WEBHOOK_SIGNING_KEK=                 # [SECRET] encrypts stored outbound-webhook signing keys
TICKET_DELETION_ENC_KEY=            # [SECRET] encrypts ticket-deletion payloads

# ---- Background jobs / schedulers (env-gated; off unless set) -----------------
JOBS_SECRET=                         # [SECRET] guards the /jobs run endpoints; required to run cron-style jobs
CUSTOMER_IMPORT_WORKER_ENABLED=      # Scaling Phase 5: `true` to drain bulk imports off the request path
BILLING_EXPORT_WORKER_ENABLED=       # `true` to process async accounting exports
FOLLOWUP_SCHEDULER_DISABLED=         # set to disable the follow-up scheduler
FOLLOWUP_SCHEDULER_INTERVAL_MS=      # optional tick interval
FOLLOWUP_PURGE_AFTER_DAYS=           # optional retention
TECH_ACCEPTANCE_SCHEDULER_DISABLED=  # set to disable the tech-acceptance scheduler
TECH_ACCEPTANCE_SCHEDULER_INTERVAL_MS=
TECH_ACCEPTANCE_TIMEOUT_SECONDS=
SCHEDULED_REPORTS_CRON_SECRET=       # [SECRET] required if scheduled reports cron is used
TENANT_WARNING_DISPATCH_CRON_SECRET= # [SECRET]
MEMBERSHIP_BILLING_SECRET=           # [SECRET]

# ---- AI (optional; only if AI features are enabled) --------------------------
AI_MAX_TOKENS=                       # optional cap
AI_BILLING_WEBHOOK_SECRET=           # [SECRET] verifies AI billing webhooks
AI_BILLING_WEBHOOK_SCHEME=           # optional scheme

# ---- Media / uploads (Scaling Phase 4 — CDN/S3 later) ------------------------
MEDIA_ROOT=                          # local media dir (default ./media); swap to an S3 adapter later
SUPPORT_ATTACHMENTS_ROOT=            # local support-attachments dir

# ---- Maps / nearby-salon search (optional) -----------------------------------
ENABLE_GOOGLE_NEARBY_SALON_SEARCH=   # `1` to enable Google-backed nearby search
GOOGLE_PLACES_API_KEY=               # [SECRET] if nearby search enabled
GOOGLE_MAPS_SERVER_API_KEY=          # [SECRET]
GOOGLE_MAPS_DEFAULT_COUNTRY=         # e.g. US
DEFAULT_NEARBY_RADIUS_MILES=
MAX_NEARBY_RADIUS_MILES=

# ---- Notifications / receipts / misc (optional) ------------------------------
RECEIPTS_EMAIL_ENABLED=              # `1` to send email receipts
RECEIPTS_SMS_ENABLED=                # `1` to send SMS receipts
FCM_SERVER_KEY=                      # [SECRET] push notifications
INVITE_NOTIFIER_URL=                 # external notifier hook
REPORTS_NOTIFIER_URL=
BRAND_EMAIL_LOGO_URL=
BRANDING_ALLOW_LOGO_REPLACE=
MFA_REQUIRE_TOTP=                    # `1` to force TOTP MFA
AUTH_SESSION_TTL=                    # optional session lifetime override
GO_CHECKIN_TOKEN_TTL_DAYS=
LOYALTY_TIERS_JSON=                  # optional JSON override
PLAN_PRICES_JSON=                    # optional JSON override
HEALTH_METRICS_SAMPLE_RATE=
REMINDERS_DEFAULT_TZ=                # optional default timezone for reminders (e.g. America/New_York)

# ---- Media object storage / CDN (Scaling Phase 4) ----------------------------
MEDIA_STORE=                         # `s3` to store uploads in object storage (survives redeploys, CDN-servable); default: local disk
MEDIA_S3_BUCKET=                     # required when MEDIA_STORE=s3
MEDIA_S3_REGION=                     # e.g. us-east-1 (falls back to AWS_REGION)
MEDIA_S3_ENDPOINT=                   # for S3-compatible providers (Cloudflare R2, DigitalOcean Spaces, MinIO); omit for AWS
MEDIA_CDN_BASE_URL=                  # e.g. https://cdn.aipowersalon.com — returned media URLs point here (the CDN edge)
MEDIA_S3_PREFIX=                     # optional object-key prefix within the bucket
MEDIA_S3_FORCE_PATH_STYLE=           # `true` for MinIO/some S3-compatible providers
MEDIA_ENV=                           # Phase 11: key segment <prefix>/<env>/… (default: NODE_ENV) — set `staging` on staging if it shares the bucket
MEDIA_LIVE_IMAGE_BASE=               # Phase 11: base URL for legacy rows holding a bare filename (e.g. https://<old-bucket>.s3.<region>.amazonaws.com/uploads/images/) — no hard-coded default any more
MEDIA_LIFECYCLE=                     # Phase 11: `off` stops the daily media.lifecycle job (default on; policy = classes.media in apps/api/db/retention-policy.json)
MIGRATE_ON_START=                    # Phase 11: `1` = migrate in the container CMD (single-container hosts only). Railway migrates in the pre-deploy command.
# Requires the @aws-sdk/client-s3 package installed when MEDIA_STORE=s3 (lazy-loaded; not needed on local disk).
