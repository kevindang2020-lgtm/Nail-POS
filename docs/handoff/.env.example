# AIPowerSalon API — environment template. Copy to your secrets manager (do NOT commit real secrets).
# ---- Runtime ----
NODE_ENV=production
PORT=3000                         # App Runner: set the service port to match (or override PORT)
REPO_DRIVER=postgres              # 'postgres' uses the live DB; unset falls back to in-memory adapters (dev/tests only)
PG_POOL_MAX=10
# RDS PostgreSQL. Append ?sslmode=require for RDS (or ?sslmode=no-verify inside a trusted VPC if the CA chain is an issue).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aps?sslmode=require

# ---- Security (MUST be stable & secret in production; rotating them invalidates sessions / encrypted secrets) ----
AUTH_SESSION_SECRET=change-me-to-a-long-random-string   # signs the aps_session cookie
AUTH_SESSION_TTL=86400                                  # seconds (optional; defaults applied if unset)
MFA_ENC_KEY=change-me-to-a-stable-32-byte-key           # encrypts TOTP/MFA secrets — keep CONSTANT across deploys

# ---- Payments ----
# Leave PAYMENTS_SANDBOX UNSET in production. Setting it to 1 enables a TEST mode that records simulated 'sbx_' card
# approvals/refunds/voids (never real charges). With it unset, card/split honestly return "not configured" until a real MID.
# PAYMENTS_SANDBOX=1
#
# Live card processing — Fiserv / CardConnect (CardPointe) Gateway. When merchid + username + password (+ a base URL or
# site) are all set, fiservStatus flips to "connected" and card sales / refunds / voids route through the real client
# (authorize+capture via PUT /cardconnect/rest/auth, etc.); the sandbox synth is then disabled. The PAN never reaches us —
# the front-end sends a CardPointe hosted-tokenizer token, which the POS passes as cardToken.
# CARDPOINTE_SITE=                   # e.g. "myco" => https://myco.cardconnect.com   (or set CARDPOINTE_BASE_URL directly)
# CARDPOINTE_BASE_URL=               # full base URL incl. scheme, no trailing slash (overrides CARDPOINTE_SITE)
# CARDPOINTE_MERCHID=                # Fiserv/CardConnect MID
# CARDPOINTE_USERNAME=               # Gateway API username (HTTP Basic)
# CARDPOINTE_PASSWORD=               # Gateway API password (HTTP Basic)
# CARDPOINTE_CURRENCY=USD


# ---- Receipts / notifications (optional; unset → Mock senders that SIMULATE delivery, receipt still recorded) ----
# SMS via Twilio when all three are set; email via SendGrid when both are set. Same creds-gated pattern as password-reset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SENDGRID_API_KEY=
# SENDGRID_FROM=

# ---- Optional JSON config (sensible defaults applied if unset) ----
# LOYALTY_TIERS_JSON=
# PLAN_PRICES_JSON=

# ---- One-time seed (used only by scripts/seed.ts to bootstrap the first super-admin + tenant; not needed at runtime) ----
SEED_SUPER_ADMIN_EMAIL=admin@yoursalon.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_TENANT_CODE=PALACE
SEED_TENANT_NAME=Palace Nails
SEED_TENANT_SLUG=palace
SEED_TENANT_LEGAL=Palace Nails LLC
SEED_TENANT_EMAIL=owner@yoursalon.com
SEED_OWNER_EMAIL=owner@yoursalon.com
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST=Owner
SEED_OWNER_LAST=Name
SEED_BRANCH_NAME=Main
SEED_PLAN=pro


# ----------------------------------------------------------------------------
# Multi-instance scaling (Redis). DEFAULT = single API node, no Redis required.
# Leave these as-is for one node; switch to redis only when running 2+ API
# instances behind a load balancer. See MULTI_INSTANCE_SCALING.md.
# ----------------------------------------------------------------------------
REALTIME_BUS=inprocess              # inprocess (default) | redis  — SSE fan-out across nodes
LOGIN_THROTTLE_STORE=memory         # memory (default)    | redis  — shared brute-force lockout
# REDIS_URL=redis://localhost:6379  # shared default; used when a feature-specific URL below is unset
# REALTIME_REDIS_URL=               # overrides REDIS_URL for the realtime bus only
# REALTIME_CHANNEL=aps:realtime     # pub/sub channel name
# LOGIN_THROTTLE_REDIS_URL=         # overrides REDIS_URL for the throttle only
# LOGIN_THROTTLE_PREFIX=aps:login:throttle:

# --- Appointment reminders (merged from Project B) ---
# Shared secret for the external reminder scheduler: POST /jobs/appointment-reminders (header x-jobs-secret).
# The job returns 503 until this is set. Use a long random value in production.
# JOBS_SECRET=
# Fallback timezone for reminder firing when a tenant has none configured (default America/New_York).
# REMINDERS_DEFAULT_TZ=America/New_York

# ---- Salon Locations / Google Maps (NO real keys committed) ----
# Backend only (Geocoding API) — never sent to any frontend:
GOOGLE_MAPS_SERVER_API_KEY=
# pos-web browser map (Maps JavaScript API, restrict by HTTP referrer):
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
# Mobile apps (restrict by bundle id / SHA-1):
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
# Defaults:
GOOGLE_MAPS_DEFAULT_COUNTRY=US
GOOGLE_MAPS_DEFAULT_RADIUS_MILES=25
# Existing customer-discovery Google fill-in (optional):
GOOGLE_PLACES_API_KEY=
ENABLE_GOOGLE_NEARBY_SALON_SEARCH=false
