# apps/manager-pay-web — production build variant (BUILD_PLAN Phase 13 D, Constitution 6 §133–136). Copy to .env.production (never committed)
# and build with `npx vite build --mode production`, then `APS_MOBILE_ENV=production npx cap sync`.
# Purpose: production / store builds.
# No secret ever goes here: everything in a VITE_* variable is compiled into the app bundle and readable by anyone.
VITE_API_BASE=https://<production-api-host>
VITE_APP_ENV=production
