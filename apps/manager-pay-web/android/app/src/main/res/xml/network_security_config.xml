<?xml version="1.0" encoding="utf-8"?>
<!-- BUILD_PLAN Phase 13 D (Constitution 6 §138, audit bug 10): RELEASE network policy — TLS only, system CAs only.
     The debug build overrides this file (src/debug/res/xml/network_security_config.xml) to reach a local dev API. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
