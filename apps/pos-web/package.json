{
  "name": "aipowersalon-pos-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "perf:booking": "vite build --config perf/vite.perf.config.ts --mode production && node perf/drive.mjs",
    "perf:realtime": "vite build --config perf/vite.perf.config.ts --mode production && node perf/realtime-drive.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "@aipowersalon/api-client": "*",
    "@aipowersalon/ui": "*",
    "@aipowersalon/api-contracts": "*",
    "@aipowersalon/web-push": "*",
    "@aipowersalon/money": "*",
    "@aipowersalon/realtime-contracts": "*",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "@aipowersalon/mobile-sdk": "*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.4.5",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
