{
 "installScripts": {
  "@firebase/util": "postinstall.js reads FIREBASE_WEBAPP_CONFIG (unset in this repo's installs) to write an auto-init defaults file inside its own package directory (read Oct 27 2026)",
  "@nestjs/core": "postinstall `opencollective || exit 0` \u2014 prints the funding message; nothing written outside the package",
  "esbuild": "postinstall `node install.js` verifies / links the platform binary from the @esbuild/<platform> optional dependency",
  "fsevents": "macOS-only native file watcher (prebuilt binary); optional dependency of chokidar / vite, never installed on Linux CI",
  "protobufjs": "postinstall scripts/postinstall.js only warns when a dependent's version scheme differs (read Oct 27 2026)"
 },
