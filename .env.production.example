# AIPowerSalon API — production env template. Copy values into your secrets manager (SSM/Secrets Manager); do NOT commit real values.
# The API REFUSES TO START in production (NODE_ENV=production) unless REPO_DRIVER=postgres, DATABASE_URL, and
# AUTH_SESSION_SECRET are set (guard in apps/api/src/main.ts). It never falls back to in-memory data.

NODE_ENV=production
# Security Deep Scan C16: NODE_ENV must be exactly 'production' on the API AND the worker. Any value other than
# 'development' / 'test' now keeps MFA fail-closed (no any-6-digit fallback), but set it anyway. MFA_REQUIRE_TOTP=1 forces it.
# MFA_REQUIRE_TOTP=1
PORT=3000
REPO_DRIVER=postgres
PG_POOL_MAX=10
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/aps?sslmode=require

# Security — MUST be stable + secret (rotating invalidates sessions / encrypted secrets)
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL=86400
MFA_ENC_KEY=change-me-to-a-stable-32-byte-key

# CORS — comma-separated front-end origins that are NOT same-origin with the API.
WEB_CORS_ORIGINS=https://pos.aipowersalon.com,https://admin.aipowersalon.com,https://aipowersalon.com

# Absolute base URL of the tenant POS app. Used for invitation links and for the logo in branded emails.
# Must match a host in WEB_CORS_ORIGINS. Without it the code falls back to https://pos.aipowersalon.com.
APP_BASE_URL=https://pos.aipowersalon.com
PUBLIC_APP_URL=https://pos.aipowersalon.com

# Payments (Fiserv/CardPointe). LEAVE PAYMENTS_SANDBOX UNSET in production. Per-tenant gateway creds are stored
# encrypted per tenant; these platform-level FISERV_* vars are only the default/fallback gateway.
# PAYMENTS_SANDBOX=1                 # set ONLY for non-prod sandbox; unset = live charges
# PAYMENTS_ALLOW_ENV_FALLBACK=1      # allow the platform FISERV_* vars as the default gateway when a tenant has none
# PAYMENTS_REFUND_INQUIRY_VERIFIED=1 # ONLY after the refund-inquiry adapter is proven against the live processor; unset = an
#                                    # unclear refund the sweep would release goes to manager review instead (§33)
# FISERV_MERCHANT_ID=               # platform default CardPointe/Fiserv MID  (allowlist your Elastic IP with Fiserv)
# FISERV_SECRET=                    # platform gateway secret (server-only; surfaces masked)
# FISERV_RESIDUAL_URL=              # residual reporting endpoint (optional)
# FISERV_RESIDUAL_AUTH=             # residual reporting auth (optional)
#
# Payment webhooks (processor → platform). Signatures are verified before any money is applied; an invalid signature is
# rejected 401 and nothing is posted. Set RAW_BODY=1 in production so the exact bytes are available to verify.
PAYMENTS_WEBHOOK_RAW_BODY=1         # REQUIRED in prod: capture raw body for signature verification (strict)
# (Fiserv/CardPointe/Clover use the generic HMAC-SHA256 hex scheme by default; confirm the exact header against sandbox.)

# SMS (Twilio) — all three required for live SMS; unset → mock sender that simulates delivery (receipt still recorded).
# Requires A2P 10DLC brand+campaign registration before carriers deliver.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email (SendGrid) — both required for live email; unset → mock sender.
# SENDGRID_API_KEY=
# SENDGRID_FROM=

# Push (FCM) — required for live push; unset → mock provider.
# FCM_SERVER_KEY=
#
# Go Check-In device tokens — kiosk pairing tokens auto-expire after this many days (regenerate re-issues + re-activates).
# GO_CHECKIN_TOKEN_TTL_DAYS=90      # default 90; set 0 to never expire (existing devices with no expiry are unaffected)

# Multi-instance scaling (Redis) — REQUIRED when running 2+ API nodes behind a load balancer (else SSE events don't
# reach clients on other nodes and login lockout won't accumulate). A single node can use inprocess/memory.
REALTIME_BUS=redis                  # inprocess | redis
LOGIN_THROTTLE_STORE=redis          # memory | redis
REDIS_URL=redis://CHANGE_ME:6379    # shared Redis (ElastiCache) for all nodes
# REALTIME_REDIS_URL=               # optional separate Redis for the realtime bus
# LOGIN_THROTTLE_REDIS_URL=         # optional separate Redis for the throttle
# Security Deep Scan C4: the second-factor / step-up / change-password / temporary-password attempt budget lives in
# Postgres (auth_events) and needs no Redis. RATE_LIMIT_STORE=redis (+ REDIS_URL) is still what turns on the per-tenant
# rate limiter and the voice-key limiter — without it those two are no-ops.
# RATE_LIMIT_STORE=redis

# Front-end build arg (NOT read by the API) — set when BUILDING each web/native app so it calls the right API:
#   VITE_API_BASE=https://api.aipowersalon.com         (kiosk uses window.APS_API_BASE)
#   VITE_FIREBASE_WEB_CONFIG / VITE_FIREBASE_VAPID_KEY  POS + Super Admin browser push (see .env.example); without both it stays off

# ---- Mobile deep links / universal links (needed for push-tap + link opens) --
# Until these are set, /.well-known/apple-app-site-association, /.well-known/assetlinks.json
# and /app-links/* answer 404 and links open the browser instead of the app.
APPLE_TEAM_ID=                       # 10-char Apple team id (App IDs need the Associated Domains capability)
ANDROID_CERT_SHA256_CUSTOMER=        # release signing cert SHA-256 (Play Console > App integrity)
ANDROID_CERT_SHA256_TECH=
ANDROID_CERT_SHA256_OWNER=
ANDROID_CERT_SHA256_MANAGER_PAY=
APP_LINK_WEB_CUSTOMER=               # https:// web fallback for /app-links/customer/* when the app is not installed
APP_LINK_WEB_TECH=
APP_LINK_WEB_OWNER=
APP_LINK_WEB_MANAGER_PAY=
