{
  "name": "@aipowersalon/marketing",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing domain module: the salon's own advertising on its customer display (23-inch dual-screen spec §47–§114). Depends on packages and the platform module only; consumed compiled by apps/api.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aipowersalon/api-contracts": "*",
    "@aipowersalon/database": "*",
    "@aipowersalon/date-time": "*",
    "@aipowersalon/media": "*",
    "@aipowersalon/permissions": "*",
    "@aipowersalon/platform": "*",
    "@aipowersalon/realtime-contracts": "*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "kysely": "^0.27.4",
    "multer": "*",
    "reflect-metadata": "0.2.1"
  },
  "devDependencies": {
    "@aipowersalon/testing": "*",
    "@electric-sql/pglite": "0.5.1",
    "@types/node": "20.11.30"
  }
}
