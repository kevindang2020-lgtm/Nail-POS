    "check:openapi": "node scripts/openapi.mjs --check",
    "check:critical-step-up": "node scripts/check-critical-step-up.mjs",
    "check:mass-assignment": "node scripts/check-mass-assignment.mjs",
    "check:api-contract": "node scripts/check-api-contract.mjs",
    "check:list-queries": "node scripts/check-list-queries.mjs",
    "check:async-exports": "node scripts/check-async-exports.mjs",
    "check:v1-clients": "node scripts/check-v1-clients.mjs",
    "check:mobile-transport": "node scripts/check-mobile-transport.mjs",
    "check:validated-bodies": "node scripts/check-validated-bodies.mjs",
    "check:strict-bodies-types": "node scripts/strict-bodies-typeproof.mjs --check",
    "check:response-exposure": "node scripts/audit-response-exposure.mjs",
    "check:uploads": "node scripts/audit-uploads.mjs",
    "check:state-transitions": "node scripts/audit-state-transitions.mjs",
    "check:db-ownership": "node scripts/db-ownership.mjs --check",
    "check:unique-tenant-review": "node scripts/audit-unique-tenant-review.mjs",
    "check:actor-stamp": "node scripts/gen-actor-columns.mjs --check",
    "db:ownership": "node scripts/db-ownership.mjs --write",
    "db:preflight": "node scripts/db-preflight.mjs",
    "db:measure": "node scripts/db-measure.mjs",
    "openapi": "node scripts/openapi.mjs",
    "openapi:manifest": "node scripts/openapi.mjs --manifest"
