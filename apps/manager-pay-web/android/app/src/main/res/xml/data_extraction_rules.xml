<?xml version="1.0" encoding="utf-8"?>
<!-- BUILD_PLAN Phase 13 D (Constitution 6 §33, audit bug 10): nothing of this app is copied by Android cloud backup or
     device-to-device transfer (Android 12+). Tokens live in the Keystore-backed secure store, which must never be restored
     onto another device; the web cache is re-fetched after sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
